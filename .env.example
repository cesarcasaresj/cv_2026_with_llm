# Copiar este archivo a .env y cambiar los valores. El archivo .env NUNCA se sube a git.
# Única excepción a la regla "todo en Vault" (constitution.md, sección 2): solo para desarrollo local.

# Credenciales iniciales del contenedor de PostgreSQL (se copian a Vault con .vault/seed.sh)
POSTGRES_USER=cv_app
POSTGRES_PASSWORD=cambia-esta-clave

# Token del Vault local en modo dev
VAULT_DEV_TOKEN=cambia-este-token

# Variables que lee el backend (usar el mismo valor de VAULT_DEV_TOKEN en VAULT_TOKEN)
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=cambia-este-token
VAULT_POSTS_DB_PATH=cv-app/database
# Clave de firma de las sesiones JWT (se genera sola en dev-up.ps1; en Vault, no aquí)
VAULT_JWT_PATH=cv-app/jwt
PORT=8081

# Origen público del sitio (sitemap.xml, robots.txt) y base de las imágenes de los artículos.
# Para usar un CDN más adelante, basta con cambiar IMAGE_BASE_URL (spec.md, decisión H).
PUBLIC_SITE_URL=http://localhost:4200
IMAGE_BASE_URL=/images/articulos
