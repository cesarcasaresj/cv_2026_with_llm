{
  "name": "cv-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate:api": "openapi-typescript ../contracts/openapi.yaml -o src/generated/api.ts",
    "dev": "node --env-file-if-exists=../.env --import tsx src/main.ts",
    "create:user": "node --env-file-if-exists=../.env --import tsx scripts/create-user.ts",
    "load:content": "node --env-file-if-exists=../.env --import tsx scripts/load-content.ts",
    "load:linkedin": "node --env-file-if-exists=../.env --import tsx scripts/load-linkedin.ts",
    "load:profile": "node --env-file-if-exists=../.env --import tsx scripts/load-profile.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "node scripts/build.mjs",
    "build:images": "node --import tsx scripts/load-content.ts --images-only",
    "db:migrate": "node --env-file-if-exists=../.env --import tsx scripts/migrate.ts",
    "prod": "node --env-file=../.env.production.local --import tsx"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.14.0",
    "express": "^5.3.0",
    "jose": "^6.2.17",
    "marked": "^18.2.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "esbuild": "^0.28.2",
    "gray-matter": "^4.0.3",
    "openapi-typescript": "^7.13.0",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
