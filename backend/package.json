{
  "name": "cv-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate:api": "openapi-typescript ../contracts/openapi.yaml -o src/generated/api.ts",
    "dev": "node --env-file-if-exists=../.env --import tsx src/main.ts",
    "create:user": "node --env-file-if-exists=../.env --import tsx scripts/create-user.ts",
    "load:content": "node --env-file-if-exists=../.env --import tsx scripts/load-content.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "express": "^5.3.0",
    "jose": "^6.2.17",
    "marked": "^18.2.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "gray-matter": "^4.0.3",
    "openapi-typescript": "^7.13.0",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
